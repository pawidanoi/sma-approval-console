# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงเอง (ห้าม commit .env เข้า git)
#
# หาได้จาก: Supabase dashboard ของโปรเจกต์เดียวกับ sma-booking-backend
#   -> Project Settings -> API -> Project URL (=SUPABASE_URL)
#   -> Project Settings -> API -> service_role secret key (=SUPABASE_SERVICE_ROLE_KEY)
# หรือจาก Vercel dashboard ของโปรเจกต์ sma-booking-backend -> Settings -> Environment Variables
# (มีค่าเดียวกันอยู่แล้วเพราะระบบเดิมก็ใช้ค่านี้เชื่อม Supabase)

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# รหัสพนักงานที่ใช้ดึงข้อมูลอ้างอิง (สาขา/ที่พัก/ทีม/พนักงาน) จาก API ของระบบเดิม
# ใช้รหัสพี่เองได้เลย (CMT2400392) หรือรหัสพนักงานจริงคนไหนก็ได้ที่ล็อกอินระบบเดิมได้
BOOTSTRAP_ACTOR_CODE=CMT2400392

PORT=4310
